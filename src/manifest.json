{
  "schemaVersion": 1,
  "id": "reading-mode-plugin",
  "name": "מצב קריאה",
  "version": "2.1.0",
  "description": "קריאה בטורים נגללים כמו בוורד, כקורא משובץ בכרטיסיית הספר, עם ספרייה, מפרשים, סימניות וייצוא לוורד. מבוסס חלקית על תוסף \"שני טורים\".",
  "author": "שני טורים",
  "type": "webapp",
  "entrypoint": "index.html",
  "category": "Utilities",
  "stability": "beta",
  "minAppVersion": "0.9.98.3",
  "sdkVersion": "1.x",
  "permissions": [
    "library.books.read",
    "library.content.read",
    "reader.open",
    "reader.toolbar",
    "app.startup_contributions",
    "app.shortcuts",
    "app.info.read",
    "navigation.write",
    "settings.read",
    "fs.user_files.write",
    "library.links.read",
    "bookmarks.read",
    "bookmarks.write",
    "search.fulltext.read",
    "ui.feedback",
    "plugin.storage.read",
    "plugin.storage.write",
    "events.subscribe:theme.changed",
    "search.field_actions"
  ],
  "contributes": {
    "toolTab": {
      "title": "מצב קריאה",
      "order": 190,
      "defaultPinned": true,
      "iconName": "book_open_24_regular"
    },
    "startup": {
      "toolbarItems": [
        {
          "id": "reading-mode-toggle",
          "title": "מצב קריאה / קורא רגיל",
          "icon": "text_column_two_24_regular",
          "contexts": [
            "reader-text"
          ],
          "type": "split",
          "children": [
            {
              "id": "rm-clean",
              "title": "מסך נקי (Esc ליציאה)",
              "icon": "full_screen_maximize_24_regular"
            },
            {
              "id": "rm-mode",
              "title": "החלפת כיוון גלילה (לצד ⇄ למטה)",
              "icon": "arrow_bidirectional_up_down_24_regular"
            },
            {
              "id": "rm-cols",
              "title": "מספר טורים (1–5)",
              "icon": "text_column_two_24_regular"
            },
            {
              "id": "rm-page",
              "title": "מעבר לעמוד… (Ctrl+G)",
              "icon": "document_page_number_24_regular"
            },
            {
              "id": "rm-report",
              "title": "שליחת דיווח על התוסף",
              "icon": "person_feedback_24_regular"
            }
          ]
        }
      ],
      "shortcuts": [
        {
          "id": "reading-mode-shortcut",
          "label": "פתח במצב קריאה",
          "key": "ctrl+shift+k",
          "command": "word-reader-open"
        }
      ],
      "searchFieldActions": [
        {
          "id": "reading-mode-find",
          "title": "פתח במצב קריאה",
          "icon": "book_open_24_regular",
          "fields": [
            "library",
            "findRef"
          ]
        }
      ]
    }
  }
}